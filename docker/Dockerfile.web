FROM node:22.23.3-bookworm-slim AS client
WORKDIR /workspace/apps/client
COPY apps/client/package.json apps/client/pnpm-lock.yaml apps/client/pnpm-workspace.yaml ./
RUN npm install --global pnpm@12.11.2 \
    && pnpm install --frozen-lockfile
COPY apps/client ./
RUN pnpm build

FROM python:3.12.8-slim-bookworm AS web
RUN python -m pip install --no-cache-dir --only-binary=:all: uv==0.6.6
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"
WORKDIR /workspace
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project \
    && useradd --create-home --uid 1000 app \
    && mkdir -p /data/media \
    && chown -R app:app /opt/venv /data
COPY --chown=app:app apps ./apps
COPY --chown=app:app README.md ./
COPY --from=client --chown=app:app /workspace/apps/client/dist ./apps/client/dist
USER app
RUN uv sync --frozen --no-dev
CMD ["sh", "-c", "python -m apps.cli.main manage migrate --noinput && exec python -m apps.cli.main web --host 0.0.0.0 --port 8000 --no-reload"]

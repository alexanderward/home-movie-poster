FROM node:22.23.3-bookworm-slim AS client
WORKDIR /workspace/apps/client
COPY apps/client/package.json apps/client/pnpm-lock.yaml apps/client/pnpm-workspace.yaml ./
RUN npm install --global pnpm@12.11.2 && pnpm install --frozen-lockfile
COPY apps/client ./
RUN pnpm run build

FROM nginx:1.28.0-alpine
COPY docker/nginx.production.conf /etc/nginx/nginx.conf
COPY --from=client /workspace/apps/client/dist /usr/share/nginx/html
RUN mkdir -p /tmp/client_temp /tmp/proxy_temp \
    && chown -R nginx:nginx /tmp/client_temp /tmp/proxy_temp /usr/share/nginx/html
USER nginx
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]

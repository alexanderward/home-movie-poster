WEB_PORT=8000

DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],home-movie-poster.local

POSTER_DATABASE_PATH=.data/poster.sqlite3
POSTER_MEDIA_ROOT=.media
POSTER_TIME_ZONE=America/Chicago

# TMDB supplies search and metadata. Keep the real read token only in .env.
TMDB_READ_TOKEN=

LOG_JSON=false
LOG_LEVEL=INFO

# Direct read-only Strato connection when multicast discovery cannot cross the LAN layout.
KALEIDESCAPE_MANUAL_HOST=

POSTGRES_DB=home_movie_poster
POSTGRES_USER=movie_poster
POSTGRES_PASSWORD=movie-poster-local-development
POSTGRES_PORT=5433
DATABASE_HOST=127.0.0.1

REDIS_PORT=6379
POSTER_REDIS_URL=redis://127.0.0.1:6379/0

WEB_PORT=8000
CLIENT_PORT=5173
VITE_USE_POLLING=0
WATCHFILES_FORCE_POLLING=false

DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],home-movie-poster.local
POSTER_TIME_ZONE=America/Chicago
POSTER_MEDIA_ROOT=.media

# Optional TMDB application read token. Keep real values only in .env.
TMDB_READ_TOKEN=

LOG_JSON=false
LOG_LEVEL=INFO

# Optional fallback when multicast discovery is unavailable. Prefer discovery.
KALEIDESCAPE_MANUAL_HOST=
